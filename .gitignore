# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Environment
.env
.env.*

# Raw data cache: regenerated by scripts/refresh.py, never committed.
# The manifest IS committed so the provenance record survives.
data/raw/*
!data/raw/.gitkeep
!data/raw/MANIFEST.md

# Claude Code plugin scratch data (healthcare Contracts Analyzer sqlite, etc).
# Project-level .claude config stays tracked, only the data cache is excluded.
.claude/data/

# OS
Thumbs.db
.DS_Store
desktop.ini

.vercel
